# OrgSight backend secrets and optional services
# Copy to org_lvl_analysis_backend/org_lvl_analysis_backend/.env

# Required on first startup when no admin user exists in the database
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password

# Keep stable across restarts (otherwise all sessions invalidate on restart)
JWT_SECRET=generate-a-long-random-string-here

# Optional: set to "production" to tighten cookie security
# ENVIRONMENT=development

# --- Azure OpenAI (required for LLM features: column mapping, rationalisation, chat) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# Optional LLM tuning
# AZURE_OPENAI_MODEL_FAMILY=
# AZURE_OPENAI_REASONING_BUDGET_MULTIPLIER=2.5
# AZURE_OPENAI_REASONING_MIN_OUTPUT_TOKENS=1024
# RATIONALISATION_BATCH_SIZE=200
# LLM_MAX_WORKERS=10

# --- Optional SMTP (user invite / notification emails) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com

# --- Optional DuckDB session limit ---
# DUCKDB_MAX_USER_SESSIONS=32
