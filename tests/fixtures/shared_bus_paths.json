      "children": [{ "x": 50, "y": 198 }],
      "expected": "M 420 138 V 165 H 170 V 198"
    },
    {
      "name": "single child to the right of parent",
      "parent": { "x": 50, "y": 0 },
      "children": [{ "x": 400, "y": 198 }],
      "expected": "M 170 138 V 165 H 520 V 198"
    },
    {
