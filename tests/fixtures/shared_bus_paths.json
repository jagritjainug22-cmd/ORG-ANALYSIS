{
  "constants": {
    "CARD_WIDTH": 240,
    "CARD_HEIGHT": 138,
    "PORT_RADIUS": 6
  },
  "cases": [
    {
      "name": "empty children",
      "parent": { "x": 0, "y": 0 },
      "children": [],
      "expected": ""
    },
    {
